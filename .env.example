# Copia este archivo a .env y completa los valores. .env NUNCA se sube a GitHub.
# Genera secretos con: openssl rand -base64 48

# Puerto local de la API en tu máquina (docker compose)
APP_PORT=8080

# Base de datos (docker compose crea la BD "contabilidad" con este usuario)
DB_USER=contabilidad
DB_PASSWORD=
# Solo para ejecutar sin Docker (mvnw spring-boot:run) o en Render + Neon:
DB_URL=jdbc:postgresql://localhost:5432/contabilidad

# Seguridad (obligatorias, mínimo 32 bytes)
JWT_SECRET=
INTEGRATION_HMAC_SECRET=
# Orígenes permitidos separados por coma, sin *
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Primer administrador (opcional; contraseña de 12+ caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Datos demo ficticios (usuario de solo lectura demo@demo.com)
DEMO_DATA=true
DEMO_PASSWORD=
